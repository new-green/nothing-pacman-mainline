# Merge on top of arm64 defconfig:
#   make ARCH=arm64 defconfig
#   ./scripts/kconfig/merge_config.sh -m .config pacman.config && make ARCH=arm64 olddefconfig

CONFIG_ARCH_MEDIATEK=y

# Framebuffer left on by the bootloader -> text console
CONFIG_SYSFB=y
CONFIG_DRM=y
CONFIG_DRM_SIMPLEDRM=y
CONFIG_DRM_FBDEV_EMULATION=y
CONFIG_FRAMEBUFFER_CONSOLE=y
CONFIG_FRAMEBUFFER_CONSOLE_ROTATION=y
CONFIG_FONTS=y
CONFIG_FONT_8x16=y
CONFIG_FONT_TER16x32=y

# Keep the bootloader's watchdog fed
CONFIG_WATCHDOG=y
CONFIG_MEDIATEK_WATCHDOG=y
CONFIG_WATCHDOG_HANDLE_BOOT_ENABLED=y

# UART (only useful if you can reach the pads)
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_SERIAL_8250_MT6577=y

# Crash logs survive a reboot
CONFIG_PSTORE=y
CONFIG_PSTORE_CONSOLE=y
CONFIG_PSTORE_RAM=y

# Keep logs readable, don't reboot on panic
CONFIG_PRINTK_TIME=y
CONFIG_PANIC_TIMEOUT=5

# vendor_boot ramdisk is LZ4 + bootconfig appended; parse them cleanly
CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_LZ4=y
CONFIG_BOOT_CONFIG=y

# Ignore the bootloader's command line and always use ours.
# Kernel log goes to ttyGS0 (USB) and tty0; the last console= (tty0) is /dev/console.
# panic=5: warm reset after a panic (RAM and pstore survive).
CONFIG_CMDLINE="console=ttyGS0,115200 console=tty0 loglevel=8 ignore_loglevel printk.devkmsg=on rdinit=/pacman-init panic=5 clk_ignore_unused pd_ignore_unused fbcon=font:TER16x32 g_cdc.dev_addr=02:50:43:4d:4e:01 g_cdc.host_addr=02:50:43:4d:4e:02 ramoops.mem_address=0x48090000 ramoops.mem_size=0xe0000 ramoops.record_size=0x1000 ramoops.console_size=0x40000 ramoops.ftrace_size=0x1000 ramoops.pmsg_size=0x80000"
CONFIG_CMDLINE_FORCE=y

# Framebuffer + frame pushing for the command-mode panel
CONFIG_FB=y
CONFIG_FB_PACMAN_CMD=y

# Built-in initramfs (ui/initramfs.list): /pacman-init = ui/pacman-init.sh (busybox sh),
# which starts pacman-dash and a shell on ttyGS0. Build first: make -C ../port/ui and
# bash ../port/tools/build-busybox.sh.
# rdinit=/pacman-init: run our init even though LK's Android ramdisk also gets unpacked.
CONFIG_BLK_DEV_INITRD=y
CONFIG_INITRAMFS_SOURCE="../port/ui/initramfs.list"
CONFIG_DEVTMPFS=y

# USB serial gadget, stage 1 (DTB: hybrid/test-U.dts)
# mtu3 in peripheral mode (dr_mode from DT) + xsphy u2 port -> g_serial (CDC ACM).
# PC: lsusb shows 0525:a4a7 "Gadget Serial", /dev/ttyACM0 appears.
CONFIG_USB_MTU3=y
CONFIG_USB_MTU3_DUAL_ROLE=y
CONFIG_PHY_MTK_XSPHY=y
CONFIG_USB_GADGET=y
# g_cdc = CDC composite: ACM (ttyGS0 shell + console) + ECM (usb0 network), 0525:a4aa.
# Replaced g_serial (0525:a4a7); only one legacy gadget can be built in.
# CONFIG_USB_G_SERIAL is not set
CONFIG_USB_CDC_COMPOSITE=y

# Stage 2: kernel console on ttyGS0 (console=ttyGS0 above)
CONFIG_U_SERIAL_CONSOLE=y

# Slim kernel: LK refuses an Image much above 19-20 MiB lz4 / ~44 MiB (see CLAUDE.md).
# Only MediaTek; every other platform (and the drivers that depend on it) off.
# CONFIG_ARCH_ACTIONS is not set
# CONFIG_ARCH_AIROHA is not set
# CONFIG_ARCH_ALPINE is not set
# CONFIG_ARCH_APPLE is not set
# CONFIG_ARCH_ARTPEC is not set
# CONFIG_ARCH_ASPEED is not set
# CONFIG_ARCH_AXIADO is not set
# CONFIG_ARCH_BCM is not set
# CONFIG_ARCH_BCM2835 is not set
# CONFIG_ARCH_BCMBCA is not set
# CONFIG_ARCH_BCM_IPROC is not set
# CONFIG_ARCH_BERLIN is not set
# CONFIG_ARCH_BLAIZE is not set
# CONFIG_ARCH_BRCMSTB is not set
# CONFIG_ARCH_BST is not set
# CONFIG_ARCH_CIX is not set
# CONFIG_ARCH_EXYNOS is not set
# CONFIG_ARCH_GOOGLE is not set
# CONFIG_ARCH_HISI is not set
# CONFIG_ARCH_INTEL_SOCFPGA is not set
# CONFIG_ARCH_K3 is not set
# CONFIG_ARCH_KEEMBAY is not set
# CONFIG_ARCH_LAYERSCAPE is not set
# CONFIG_ARCH_LG1K is not set
# CONFIG_ARCH_MA35 is not set
# CONFIG_ARCH_MESON is not set
# CONFIG_ARCH_MICROCHIP is not set
# CONFIG_ARCH_MVEBU is not set
# CONFIG_ARCH_MXC is not set
# CONFIG_ARCH_NPCM is not set
# CONFIG_ARCH_NXP is not set
# CONFIG_ARCH_QCOM is not set
# CONFIG_ARCH_REALTEK is not set
# CONFIG_ARCH_RENESAS is not set
# CONFIG_ARCH_ROCKCHIP is not set
# CONFIG_ARCH_S32 is not set
# CONFIG_ARCH_SEATTLE is not set
# CONFIG_ARCH_SOPHGO is not set
# CONFIG_ARCH_SPARX5 is not set
# CONFIG_ARCH_SPRD is not set
# CONFIG_ARCH_STM32 is not set
# CONFIG_ARCH_SUNXI is not set
# CONFIG_ARCH_SYNQUACER is not set
# CONFIG_ARCH_TEGRA is not set
# CONFIG_ARCH_TESLA_FSD is not set
# CONFIG_ARCH_THUNDER is not set
# CONFIG_ARCH_THUNDER2 is not set
# CONFIG_ARCH_UNIPHIER is not set
# CONFIG_ARCH_VEXPRESS is not set
# CONFIG_ARCH_VISCONTI is not set
# CONFIG_ARCH_XGENE is not set
# CONFIG_ARCH_ZYNQMP is not set

# Temperatures from the MCUPM thermal firmware (SRAM @0x114000, DT "mediatek,therm_intf"):
# zones cpu0..7/gpu in /sys/class/thermal, critical trip powers off (mtk_therm_intf.crit_temp)
CONFIG_MTK_THERMAL=y
CONFIG_MTK_THERM_INTF=y

# Stage 2: SPMI (PMIF, MT8195 layout) + MT6363 PMIC keys, polled (power, volume up)
CONFIG_SPMI=y
CONFIG_SPMI_MTK_PMIF=y
CONFIG_REGMAP_SPMI=y
CONFIG_KEYBOARD_MT6363_POLLED=y
CONFIG_INPUT_EVDEV=y

# DEBUG (reset investigation, 2026-11-09): allow reading RAM through /dev/mem so LK's own log
# (mblock "log_store", with [RGU]/[PMIC] reset reasons) can be read from mainline. Revert later.
# CONFIG_STRICT_DEVMEM is not set
