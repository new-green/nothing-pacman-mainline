# Merge on top of arm64 defconfig:
#   make ARCH=arm64 defconfig
#   ./scripts/kconfig/merge_config.sh -m .config pacman.config && make ARCH=arm64 olddefconfig

CONFIG_ARCH_MEDIATEK=y

# Framebuffer left on by the bootloader -> text console
CONFIG_SYSFB=y
CONFIG_DRM=y
CONFIG_DRM_SIMPLEDRM=y
CONFIG_DRM_FBDEV_EMULATION=y
CONFIG_FRAMEBUFFER_CONSOLE=y
CONFIG_FRAMEBUFFER_CONSOLE_ROTATION=y
CONFIG_FONTS=y
CONFIG_FONT_8x16=y
CONFIG_FONT_TER16x32=y

# Keep the bootloader's watchdog fed
CONFIG_WATCHDOG=y
CONFIG_MEDIATEK_WATCHDOG=y
CONFIG_WATCHDOG_HANDLE_BOOT_ENABLED=y

# UART (only useful if you can reach the pads)
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_SERIAL_8250_MT6577=y

# Crash logs survive a reboot
CONFIG_PSTORE=y
CONFIG_PSTORE_CONSOLE=y
CONFIG_PSTORE_RAM=y

# Keep logs readable, don't reboot on panic
CONFIG_PRINTK_TIME=y
CONFIG_PANIC_TIMEOUT=5

# vendor_boot ramdisk is LZ4 + bootconfig appended; parse them cleanly
CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_LZ4=y
CONFIG_BOOT_CONFIG=y

# Ignore the bootloader's command line and always use ours.
# Kernel log goes to ttyGS0 (USB) and tty0; the last console= (tty0) is /dev/console.
# panic=5: warm reset after a panic (RAM and pstore survive).
CONFIG_CMDLINE="console=ttyGS0,115200 console=tty0 loglevel=8 ignore_loglevel printk.devkmsg=on rdinit=/pacman-init panic=5 clk_ignore_unused pd_ignore_unused fbcon=font:TER16x32 ramoops.mem_address=0x48090000 ramoops.mem_size=0xe0000 ramoops.record_size=0x1000 ramoops.console_size=0x40000 ramoops.ftrace_size=0x1000 ramoops.pmsg_size=0x80000"
CONFIG_CMDLINE_FORCE=y

# Framebuffer + frame pushing for the command-mode panel
CONFIG_FB=y
CONFIG_FB_PACMAN_CMD=y

# Built-in initramfs (ui/initramfs.list): /pacman-init = ui/pacman-init.sh (busybox sh),
# which starts pacman-dash and a shell on ttyGS0. Build first: make -C ../port/ui and
# bash ../port/tools/build-busybox.sh.
# rdinit=/pacman-init: run our init even though LK's Android ramdisk also gets unpacked.
CONFIG_BLK_DEV_INITRD=y
CONFIG_INITRAMFS_SOURCE="../port/ui/initramfs.list"
CONFIG_DEVTMPFS=y

# USB serial gadget, stage 1 (DTB: hybrid/test-U.dts)
# mtu3 in peripheral mode (dr_mode from DT) + xsphy u2 port -> g_serial (CDC ACM).
# PC: lsusb shows 0525:a4a7 "Gadget Serial", /dev/ttyACM0 appears.
CONFIG_USB_MTU3=y
CONFIG_USB_MTU3_DUAL_ROLE=y
CONFIG_PHY_MTK_XSPHY=y
CONFIG_USB_GADGET=y
CONFIG_USB_G_SERIAL=y

# Stage 2: kernel console on ttyGS0 (console=ttyGS0 above)
CONFIG_U_SERIAL_CONSOLE=y
