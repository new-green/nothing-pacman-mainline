# Merge on top of arm64 defconfig:
#   make ARCH=arm64 defconfig
#   ./scripts/kconfig/merge_config.sh -m .config pacman.config && make ARCH=arm64 olddefconfig

CONFIG_ARCH_MEDIATEK=y

# Framebuffer left on by the bootloader -> text console
CONFIG_SYSFB=y
CONFIG_DRM=y
CONFIG_DRM_SIMPLEDRM=y
CONFIG_DRM_FBDEV_EMULATION=y
CONFIG_FRAMEBUFFER_CONSOLE=y
CONFIG_FRAMEBUFFER_CONSOLE_ROTATION=y
CONFIG_FONTS=y
CONFIG_FONT_8x16=y
CONFIG_FONT_TER16x32=y

# Keep the bootloader's watchdog fed
CONFIG_WATCHDOG=y
CONFIG_MEDIATEK_WATCHDOG=y
CONFIG_WATCHDOG_HANDLE_BOOT_ENABLED=y

# UART (only useful if you can reach the pads)
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_SERIAL_8250_MT6577=y

# Crash logs survive a reboot
CONFIG_PSTORE=y
CONFIG_PSTORE_CONSOLE=y
CONFIG_PSTORE_RAM=y

# Keep logs readable, don't reboot on panic
CONFIG_PRINTK_TIME=y
CONFIG_PANIC_TIMEOUT=5

# vendor_boot ramdisk is LZ4 + bootconfig appended; parse them cleanly
CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_LZ4=y
CONFIG_BOOT_CONFIG=y

# Ignore the bootloader's command line and always use ours.
# No root device: the kernel reaches the VFS panic and reboots after 5 s
# (warm reset, RAM and pstore survive).
CONFIG_CMDLINE="console=tty0 loglevel=8 ignore_loglevel printk.devkmsg=on rdinit=/pacman-init panic=5 clk_ignore_unused pd_ignore_unused fbcon=font:TER16x32 ramoops.mem_address=0x48090000 ramoops.mem_size=0xe0000 ramoops.record_size=0x1000 ramoops.console_size=0x40000 ramoops.ftrace_size=0x1000 ramoops.pmsg_size=0x80000"
CONFIG_CMDLINE_FORCE=y

# Framebuffer + frame pushing for the command-mode panel
CONFIG_FB=y
CONFIG_FB_PACMAN_CMD=y

# Built-in initramfs: /init = ui/pacman-dash (build it first: make -C ../port/ui).
# rdinit=/pacman-init: run our program even if LK's Android ramdisk also gets unpacked.
CONFIG_BLK_DEV_INITRD=y
CONFIG_INITRAMFS_SOURCE="../port/ui/initramfs.list"
CONFIG_DEVTMPFS=y
