+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * Nothing Phone (2a) "Pacman" - minimal mainline boot.
+ *
+ * Memory map and reserved regions copied from the DTB the bootloader (LK)
+ * passes to the stock kernel (/sys/firmware/fdt on a running device).
+ *
+ * Framebuffer: atag,videolfb-fb_base = 0xfe050000. The panel is a DSI
+ * command-mode panel, so writes to this buffer only reach the screen
+ * when the display engine pushes a frame; simple-framebuffer alone
+ * will not show anything yet.
+ */
+
+/dts-v1/;
+
+#include "mt6886.dtsi"
+#include "mt6886-nothing-pacman-overlay-sink.dtsi"
+
+#define FB_BASE		0xfe050000
+#define FB_WIDTH	1080
+#define FB_HEIGHT	2412
+#define FB_STRIDE	(1088 * 4)
+#define FB_SIZE		0x01fa0000
+
+/ {
+	model = "Nothing Phone (2a)";
+	/* Exactly as in the stock DTB; the bootloader may match on it */
+	compatible = "mediatek,MT6886";
+
+	aliases {
+		serial0 = &uart0;
+	};
+
+	chosen: chosen {
+		#address-cells = <2>;
+		#size-cells = <2>;
+		ranges;
+
+		/* The kernel uses its built-in command line (CONFIG_CMDLINE_FORCE) */
+		bootargs = "console=tty0";
+
+		framebuffer0: framebuffer@fe050000 {
+			compatible = "simple-framebuffer";
+			reg = <0 FB_BASE 0 FB_SIZE>;
+			width = <FB_WIDTH>;
+			height = <FB_HEIGHT>;
+			stride = <FB_STRIDE>;
+			format = "a8r8g8b8";
+		};
+	};
+
+	/* 12 GB, as reported by the bootloader */
+	memory {
+		device_type = "memory";
+		reg = <0x0 0x40000000 0x3 0x00000000>;
+	};
+
+	reserved-memory {
+		#address-cells = <2>;
+		#size-cells = <2>;
+		ranges;
+
+		/* pstore: configured on the command line (ramoops.*), same as stock */
+		pstore@48090000 {
+			reg = <0x0 0x48090000 0x0 0x000e0000>;
+			no-map;
+		};
+
+		framebuffer@fe050000 {
+			reg = <0 FB_BASE 0 FB_SIZE>;
+			no-map;
+		};
+
+		aee-debug-kinfo@48080000 {
+			reg = <0x0 0x48080000 0x0 0x00010000>;
+			no-map;
+		};
+
+		minirdump@48170000 {
+			reg = <0x0 0x48170000 0x0 0x00010000>;
+			no-map;
+		};
+
+		bl31-reserved@48200000 {
+			reg = <0x0 0x48200000 0x0 0x00200000>;
+			no-map;
+		};
+
+		crypto-hw@48410000 {
+			reg = <0x0 0x48410000 0x0 0x00010000>;
+			no-map;
+		};
+
+		aee-lk@50700000 {
+			reg = <0x0 0x50700000 0x0 0x00800000>;
+		};
+
+		adsp-image-reserved@7e000000 {
+			reg = <0x0 0x7e000000 0x0 0x00920000>;
+			no-map;
+		};
+
+		sspm-ap-shared@7f9d0000 {
+			reg = <0x0 0x7f9d0000 0x0 0x00110000>;
+			no-map;
+		};
+
+		me-gpueb-shared@7fae0000 {
+			reg = <0x0 0x7fae0000 0x0 0x00180000>;
+			no-map;
+		};
+
+		me-csffwlog-reserved@7fc60000 {
+			reg = <0x0 0x7fc60000 0x0 0x00010000>;
+			no-map;
+		};
+
+		mcupm-reserved@7fc70000 {
+			reg = <0x0 0x7fc70000 0x0 0x00100000>;
+			no-map;
+		};
+
+		sspm-reserved@7fd70000 {
