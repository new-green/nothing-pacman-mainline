			virtio-supply = <0x145>;
			irq-supply = <0x146>;
			phandle = <0x147>;
		};

		mtee {
			compatible = "mediatek,trusty-mtee-v1";
			tz-supply = <0x147>;
			phandle = <0xec>;
		};

		trusty-gz-log {
			compatible = "android,trusty-gz-log-v1";
		};

		trusty-sapu {
			compatible = "mediatek,trusty-sapu";
			power-version = <0x01>;
			iommus = <0xc7 0x1204a0>;
			status = "disabled";
		};
	};

	nebula-log {
		compatible = "android,nebula-log-v1";
		status = "disabled";
		phandle = <0x2d0>;
	};

	nebula {
		compatible = "android,nebula-smc-v1";
		ranges;
		#address-cells = <0x02>;
		#size-cells = <0x02>;
		tee-id = <0x01>;
		tee-name = "nebula";
		phandle = <0x2d1>;

		nebula-virtio {
			compatible = "android,nebula-virtio-v1";
		};

		nebula-irq {
			compatible = "android,nebula-irq-v1";
			ppi-interrupt-parent = <0x01>;
		};

		nebula-gz-log {
			compatible = "android,nebula-gz-log-v1";
		};
	};

	hypervisor {
		compatible = "mediatek,geniezone-hyp\0mediatek,geniezone";
		status = "disabled";
		phandle = <0x2d2>;
	};

	pacman-display@14017000 {
		compatible = "nothing,pacman-cmdfb";
		reg = <0x00 0x14017000 0x00 0x1000>,
		      <0x00 0x14001000 0x00 0x1000>,
		      <0x00 0xfe050000 0x00 0x1fa0000>;
		width = <1080>;
		height = <2412>;
		stride = <4352>;
	};

