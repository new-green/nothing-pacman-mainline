				compatible = "mediatek,mtk-xhci";
				reg = <0x00 0x11200000 0x00 0x1000>;
				reg-names = "mac";
				interrupts = <0x00 0xa1 0x04 0x00>;
				clocks = <0x42>;
				clock-names = "sys_ck";
				status = "okay";
				phandle = <0x122>;
			};
		};

