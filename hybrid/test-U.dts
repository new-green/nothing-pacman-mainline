			compatible = "mediatek,mtu3";
			reg = <0x00 0x11201000 0x00 0x2e00 0x00 0x11203e00 0x00 0x100>;
			reg-names = "mac\0ippc";
			/* pacman USB stage 1: no PMIC driver -> no vusb33-supply (dummy regulator) */
			interrupts = <0x00 0xa0 0x04 0x00>;
			/* only the u2 phy (PHY_TYPE_USB2); u3 port disabled via u3p-dis-msk */
			phys = <0xb7 0x03>;
			/* no pericfg_ao clock driver -> 26 MHz fixed-clock (clk26m) */
			clocks = <0x42>;
			clock-names = "sys_ck";
			#address-cells = <0x02>;
			#size-cells = <0x02>;
			ranges;
			dr_mode = "peripheral";
			maximum-speed = "high-speed";
			mediatek,u3p-dis-msk = <0x01>;
			mediatek,force-vbus;
			phandle = <0xb8>;

