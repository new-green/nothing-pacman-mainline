/dts-v1/;

/ {
	model = "MT6886";
	compatible = "mediatek,MT6886";
	interrupt-parent = <0x01>;
	#address-cells = <0x02>;
	#size-cells = <0x02>;

	aliases {
		i2c0 = "/soc/i2c@11e00000";
		i2c1 = "/soc/i2c@11e01000";
		i2c2 = "/soc/i2c@11c70000";
		i2c3 = "/soc/i2c@11e80000";
		i2c4 = "/soc/i2c@11c71000";
		i2c5 = "/soc/i2c@11280000";
		i2c6 = "/soc/i2c@11281000";
		i2c7 = "/soc/i2c@11e81000";
		i2c8 = "/soc/i2c@11e82000";
		i2c9 = "/soc/i2c@11c72000";
		i2c10 = "/soc/i2c@11282000";
		i2c11 = "/soc/i2c@11283000";
		ovl0 = "/soc/disp_ovl@14002000";
		ovl3 = "/soc/disp_ovl@14003000";
		ovl4 = "/soc/disp_ovl@14004000";
		rdma0 = "/soc/disp_rdma@14006000";
		rdma1 = "/soc/disp_rdma1@1401c000";
		wdma0 = "/soc/disp_wdma0@14018000";
		wdma1 = "/soc/disp_wdma1@1401f000";
		dsc0 = "/soc/disp_dsc_wrap@14015000";
		dsi0 = "/soc/dsi@14017000";
		rsz0 = "/soc/disp_rsz0@14005000";
		postmask0 = "/soc/disp_postmask0@1400f000";
		mtksmmu0 = "/soc/iommu@1e802000";
		mtksmmu1 = "/soc/iommu@19010000";
		color0 = "/soc/disp_color@14009000";
		ccorr0 = "/soc/disp_ccorr@1400a000";
		ccorr1 = "/soc/disp_ccorr@1400b000";
		c3d0 = "/soc/disp_c3d@14008000";
		aal0 = "/soc/disp_aal@1400d000";
		gamma0 = "/soc/disp_gamma@1400e000";
		dither0 = "/soc/disp_dither@14010000";
		chist0 = "/soc/disp_chist@14011000";
		cm0 = "/soc/disp_cm@14013000";
		spr0 = "/soc/disp_spr@14014000";
		inlinerotate0 = "/soc/inlinerot@14020000";
		y2r0 = "/soc/disp-y2r0@14000000";
		dlo-async3 = "/soc/disp-dlo-async3@14000000";
		dli-async3 = "/soc/disp-dli-async3@14000000";
		mml-wrot0 = "/soc/mml-wrot0@1f00f000";
	};

	cache-parity {
		compatible = "mediatek,mt6985-cache-parity";
		ecc-irq-support = <0x01>;
		arm-complex-ecc-hwirq = <0x28 0x29 0x2a>;
		arm-dsu-ecc-hwirq = <0x30>;
		interrupts = <0x00 0x00 0x04 0x00 0x00 0x01 0x04 0x00 0x00 0x02 0x04 0x00 0x00 0x03 0x04 0x00 0x00 0x04 0x04 0x00 0x00 0x05 0x04 0x00 0x00 0x06 0x04 0x00 0x00 0x07 0x04 0x00 0x00 0x08 0x04 0x00 0x00 0x09 0x04 0x00 0x00 0x0a 0x04 0x00 0x00 0x10 0x04 0x00>;
	};

	chosen {
		bootargs = "console=tty0 root=/dev/ram \t\t\t    rcupdate.rcu_expedited=1 \t\t\t    loglevel=8 disable_dma32=on \t\t\t    8250.nr_uarts=2 \t\t\t    allow_mismatched_32bit_el0 \t\t\t    androidboot.hardware=mt6886 \t\t\t    sched_proxy_exec=0 \t\t\t    android_arch_task_struct_size=512 \t\t\t    initcall_debug=1 cgroup.memory=nosocket,nokmem \t\t\t    vdmalloc=400M swiotlb=noforce transparent_hugepage=never \t\t\t    printk.devkmsg=on \t\t\t    firmware_class.path=/vendor/firmware \t\t\t    deferred_probe_timeout=20";
		kaslr-seed = <0x00 0x00>;
		mkp_panic = "on";
		phandle = <0x34>;
	};

	cpus {
		#address-cells = <0x01>;
		#size-cells = <0x00>;

		cpu@0 {
			device_type = "cpu";
			compatible = "arm,cortex-a55";
			performance-domains = <0x02 0x00>;
			reg = <0x00>;
			enable-method = "psci";
			cpu-idle-states = <0x03 0x04 0x05 0x06 0x07 0x08 0x09 0x0a>;
			capacity-dmips-mhz = <0x176>;
			phandle = <0x0e>;
		};

		cpu@1 {
			device_type = "cpu";
			compatible = "arm,cortex-a55";
			performance-domains = <0x02 0x00>;
			reg = <0x100>;
			enable-method = "psci";
			cpu-idle-states = <0x03 0x04 0x05 0x06 0x07 0x08 0x09 0x0a>;
			capacity-dmips-mhz = <0x176>;
			phandle = <0x0f>;
		};

		cpu@2 {
			device_type = "cpu";
			compatible = "arm,cortex-a55";
			performance-domains = <0x02 0x00>;
			reg = <0x200>;
			enable-method = "psci";
			cpu-idle-states = <0x03 0x04 0x05 0x06 0x07 0x08 0x09 0x0a>;
			capacity-dmips-mhz = <0x176>;
			phandle = <0x10>;
		};

		cpu@3 {
			device_type = "cpu";
			compatible = "arm,cortex-a55";
			performance-domains = <0x02 0x00>;
			reg = <0x300>;
			enable-method = "psci";
			cpu-idle-states = <0x03 0x04 0x05 0x06 0x07 0x08 0x09 0x0a>;
			capacity-dmips-mhz = <0x176>;
			phandle = <0x11>;
		};

		cpu@4 {
			device_type = "cpu";
			compatible = "arm,cortex-a55";
			performance-domains = <0x02 0x00>;
			reg = <0x400>;
			enable-method = "psci";
			cpu-idle-states = <0x03 0x04 0x05 0x06 0x07 0x08 0x09 0x0a>;
			capacity-dmips-mhz = <0x176>;
			phandle = <0x12>;
		};

		cpu@5 {
			device_type = "cpu";
			compatible = "arm,cortex-a55";
			performance-domains = <0x02 0x00>;
			reg = <0x500>;
			enable-method = "psci";
			cpu-idle-states = <0x03 0x04 0x05 0x06 0x07 0x08 0x09 0x0a>;
			capacity-dmips-mhz = <0x176>;
			phandle = <0x13>;
		};

		cpu@100 {
			device_type = "cpu";
			compatible = "arm,cortex-a78";
			performance-domains = <0x02 0x01>;
			reg = <0x600>;
			enable-method = "psci";
			cpu-idle-states = <0x0b 0x0c 0x0d 0x06 0x07 0x08 0x09 0x0a>;
			capacity-dmips-mhz = <0x400>;
			phandle = <0x14>;
		};

		cpu@101 {
			device_type = "cpu";
			compatible = "arm,cortex-a78";
			performance-domains = <0x02 0x01>;
			reg = <0x700>;
			enable-method = "psci";
			cpu-idle-states = <0x0b 0x0c 0x0d 0x06 0x07 0x08 0x09 0x0a>;
			capacity-dmips-mhz = <0x400>;
			phandle = <0x15>;
		};

		cpu-map {

			cluster0 {

				core0 {
					cpu = <0x0e>;
				};

				core1 {
					cpu = <0x0f>;
				};

				core2 {
					cpu = <0x10>;
				};

				core3 {
					cpu = <0x11>;
				};

				core4 {
					cpu = <0x12>;
				};

				core5 {
					cpu = <0x13>;
				};

				doe {
					phandle = <0x148>;
				};
			};

			cluster1 {

				core0 {
					cpu = <0x14>;
				};

				core1 {
					cpu = <0x15>;
				};

				doe {
					phandle = <0x149>;
				};
			};
		};

		idle-states {
			entry-method = "arm,psci";

			cpuoff-l {
				compatible = "arm,idle-state";
				arm,psci-suspend-param = <0x10000>;
				local-timer-stop;
				entry-latency-us = <0x32>;
				exit-latency-us = <0x64>;
				min-residency-us = <0x2b5c>;
				phandle = <0x03>;
			};

			cpuoff-b {
				compatible = "arm,idle-state";
				arm,psci-suspend-param = <0x10000>;
				local-timer-stop;
				entry-latency-us = <0x78>;
				exit-latency-us = <0xf0>;
				min-residency-us = <0x1db0>;
				phandle = <0x0b>;
			};

			clusteroff-l {
				compatible = "arm,idle-state";
				arm,psci-suspend-param = <0x1010001>;
				local-timer-stop;
				entry-latency-us = <0xa0>;
				exit-latency-us = <0x154>;
				min-residency-us = <0x2bc0>;
				phandle = <0x04>;
			};

			clusteroff-b {
				compatible = "arm,idle-state";
				arm,psci-suspend-param = <0x1010001>;
				local-timer-stop;
				entry-latency-us = <0xa5>;
				exit-latency-us = <0x104>;
				min-residency-us = <0x2e7c>;
				phandle = <0x0c>;
			};

			mcusysoff-l {
				compatible = "arm,idle-state";
				arm,psci-suspend-param = <0x1010007>;
				local-timer-stop;
				entry-latency-us = <0x280>;
				exit-latency-us = <0x578>;
				min-residency-us = <0x319c>;
				phandle = <0x05>;
			};

			mcusysoff-b {
				compatible = "arm,idle-state";
				arm,psci-suspend-param = <0x1010007>;
				local-timer-stop;
				entry-latency-us = <0x280>;
				exit-latency-us = <0x578>;
				min-residency-us = <0x2ee0>;
				phandle = <0x0d>;
			};

			system-mem {
				compatible = "arm,idle-state";
				arm,psci-suspend-param = <0x101000f>;
				local-timer-stop;
				entry-latency-us = <0x280>;
				exit-latency-us = <0x708>;
				min-residency-us = <0x3390>;
				phandle = <0x06>;
			};

			system-pll {
				compatible = "arm,idle-state";
				arm,psci-suspend-param = <0x101001f>;
				local-timer-stop;
				entry-latency-us = <0x280>;
				exit-latency-us = <0x73a>;
				min-residency-us = <0x3390>;
				phandle = <0x07>;
			};

			system-bus {
				compatible = "arm,idle-state";
				arm,psci-suspend-param = <0x101007f>;
				local-timer-stop;
				entry-latency-us = <0x280>;
				exit-latency-us = <0xaf0>;
				min-residency-us = <0x3390>;
				phandle = <0x08>;
			};

			system-vcore {
				compatible = "arm,idle-state";
				arm,psci-suspend-param = <0x10100ff>;
				local-timer-stop;
				entry-latency-us = <0x3ac>;
				exit-latency-us = <0xdac>;
				min-residency-us = <0x8980>;
				phandle = <0x09>;
			};

			s2idle {
				compatible = "arm,idle-state";
				arm,psci-suspend-param = <0x10180ff>;
				local-timer-stop;
				entry-latency-us = <0x2710>;
				exit-latency-us = <0x2710>;
				min-residency-us = <0xffffffff>;
				phandle = <0x0a>;
			};
		};
	};

	psci {
		compatible = "arm,psci-1.0";
		method = "smc";
	};

	prize_board_id {
		compatible = "prize,board-id";
		board_id_sel1 = <0x16 0x08 0x00>;
		io-channels = <0x17 0x317>;
		phandle = <0x14a>;
	};

	interrupt-controller {
		compatible = "arm,gic-v3";
		#interrupt-cells = <0x04>;
		#address-cells = <0x02>;
		#size-cells = <0x02>;
		#redistributor-regions = <0x01>;
		interrupt-parent = <0x01>;
		interrupt-controller;
		reg = <0x00 0xc400000 0x00 0x40000 0x00 0xc440000 0x00 0x200000>;
		interrupts = <0x01 0x09 0x04 0x00>;
		phandle = <0x01>;

		ppi-partitions {

			interrupt-partition-0 {
				affinity = <0x0e 0x0f 0x10 0x11 0x12 0x13>;
				phandle = <0x18>;
			};

			interrupt-partition-1 {
				affinity = <0x14 0x15>;
				phandle = <0x19>;
			};
		};
	};

	pmu-a510 {
		compatible = "arm,cortex-a55-pmu";
		interrupt-parent = <0x01>;
		interrupts = <0x01 0x07 0x04 0x18>;
	};

	pmu-makalu {
		compatible = "arm,cortex-a78-pmu";
		interrupt-parent = <0x01>;
		interrupts = <0x01 0x07 0x04 0x19>;
	};

	dsu-pmu-0 {
		compatible = "arm,dsu-pmu";
		interrupts = <0x00 0x12 0x04 0x00>;
		cpus = <0x0e 0x0f 0x10 0x11 0x12 0x13 0x14 0x15>;
	};

