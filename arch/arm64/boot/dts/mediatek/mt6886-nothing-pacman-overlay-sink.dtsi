		goodix_fp: goodix-fp {
			status = "disabled";
		};

		mt6368_vfp: mt6368-vfp {
			status = "disabled";
		};

		spi4: spi4 {
			status = "disabled";
		};

		mobicore: mobicore {
			status = "disabled";
		};

		mtkheap_page_svp: mtkheap-page-svp {
