			status = "disabled";
		};

		qm42195: qm42195 {
			status = "disabled";
		};

		qm45197: qm45197 {
			status = "disabled";
		};

		spi3: spi3 {
			status = "disabled";
		};

		mt6368_vtp: mt6368-vtp {
			status = "disabled";
		};

		seninf_top: seninf-top {
