/*
 * The bootloader applies Nothing's DT overlay (dtbo partition, entry 0)
 * on top of this DTB before starting the kernel. The overlay references
 * these labels; if any is missing the overlay fails and the bootloader
 * never starts the kernel. They are empty, disabled placeholders: the
 * properties the overlay adds land here and are ignored by the kernel.
 * (/chosen is labelled in the board DTS.) Build with dtc -@.
 */

/ {
	overlay-sink {
		status = "disabled";

		mtk_leds: mtk-leds {
			status = "disabled";
		};

		connfem: connfem {
			status = "disabled";
		};

		pio: pio {
			status = "disabled";
		};

		mtkfb: mtkfb {
			status = "disabled";
		};

		dispsys_config: dispsys-config {
			status = "disabled";
		};

		dsi0: dsi0 {
			status = "disabled";
		};

		gps: gps {
			status = "disabled";
		};

		ps5169: ps5169 {
			status = "disabled";
		};

		fusb304: fusb304 {
			status = "disabled";
		};

		mt6375_typec: mt6375-typec {
			status = "disabled";
		};

		typec_mux_switch: typec-mux-switch {
			status = "disabled";
		};

		i2c7: i2c7 {
			status = "disabled";
		};

		i2c3: i2c3 {
